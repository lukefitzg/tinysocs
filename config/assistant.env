# TinySocs Assistant Environment Configuration
# This file is a template — the installer overwrites values from wizard inputs.
# Manual edits are preserved on upgrade (onlyifdoesntexist flag).

# ── SIEM Connection ──
# SIEM_PASS also serves as the dashboard admin password (single password model).
# Set during install or via the dashboard Settings > Change Password.
SIEM_URL=https://localhost:9201
SIEM_USER=admin
SIEM_PASS=

# ── Shared Secrets (HMAC authentication between components) ──
MASTER_SHARED_SECRET=
BOT_SHARED_SECRET=

# ── LLM Configuration ──
# LLM_MODE: anthropic | openai | offline
LLM_MODE=offline
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OFFLINE_LLM_URL=http://localhost:11434

# ── Notifications ──
# WEBHOOK_URL: generic webhook endpoint (Slack, Teams, webhook.site, etc.)
WEBHOOK_URL=
WEBHOOK_ENABLED=1
