# .env.example
# TinySocs .env.example — Golden (OpenSearch-only, Phase 4)

# === SIEM target (OpenSearch) ===
SIEM_BACKEND=opensearch
SIEM_URL=https://localhost:9201
SIEM_USER=admin
SIEM_PASS=ChangeMe123!
SIEM_SSL_VERIFY=false
SIEM_TIMEOUT_SECONDS=30

# === LLM selection ===
LLM_MODE=openai            # openai | ollama
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Optional offline LLM (if running Ollama locally)
# LLM_MODE=ollama
# OFFLINE_LLM_URL=http://localhost:11434
# OFFLINE_LLM_MODEL=qwen2.5:0.5b-instruct

# === Paths (agent) ===
ACTIONS_QUEUE_PATH=./data/actions_queue.jsonl
TINYSOCS_RULES=tinysocs/agent/detections/rules.yaml

# === Phase 4: Federation + Ledger + Anchors ===
TINYSOCS_NODES=http://localhost:8081
MASTER_SHARED_SECRET=dev-secret-change-me
TINYSOCS_INSECURE_SKIP_VERIFY=1

# Request/timeout budgeting — robust defaults
REQUEST_TIMEOUT_SEC=30
MASTER_DEADLINE_SEC=120

# Ledger (node-local)
TINYSOCS_LEDGER_DIR=ledger
TINYSOCS_LEDGER_RETENTION_DAYS=30
TINYSOCS_SKEW_SECS=300

# Node serve defaults
TINYSOCS_NODE_WORKERS=2