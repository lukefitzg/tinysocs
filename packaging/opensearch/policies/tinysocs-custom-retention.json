{
  "policy": {
    "description": "TinySocs custom log index retention: delete indices older than 30 days",
    "default_state": "open",
    "states": [
      {
        "name": "open",
        "actions": [],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "30d"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "delete": {}
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": ["tinysocs-custom-*"],
        "priority": 200
      }
    ]
  }
}
