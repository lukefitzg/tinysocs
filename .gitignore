# -----------------------
# Virtual environments
# -----------------------
.venv/
venv/
ENV/
env/
pip-wheel-metadata/

# dotenv & local config
.env
.env.*
.envrc

# -----------------------
# Python bytecode & caches
# -----------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.cache/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# -----------------------
# Build / distribution outputs
# (keep spec files tracked)
# -----------------------
build/
dist/
artifacts/
wheelhouse/
*.egg-info/
*.egg
*.whl

# -----------------------
# .NET / dotnet build artefacts
# -----------------------
**/bin/
**/obj/
*.user
*.suo
*.userprefs

# PyInstaller products
# (avoid ignoring *.spec so packaging/*.spec can be committed)
build/**/*
dist/**/*

# Common compiled libs (scoped to build artifacts above)
# If you ever need to ignore globally, scope carefully to not hide tool bins.
# *.so
# *.dylib
# *.pyd
# *.dll

# -----------------------
# Logs & temp
# -----------------------
*.log
logs/
*.tmp
*.temp

# -----------------------
# Editor/IDE
# -----------------------
.vscode/
.idea/
*.code-workspace

# -----------------------
# OS cruft
# -----------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------
# Project runtime data (keep folder via .gitkeep)
# -----------------------
data/queue-rot/*
!data/queue-rot/.gitkeep
data/actions_queue.json
data/actions_queue.jsonl
data/feed/

# -----------------------
# Bundled vendor bins you DO want tracked
# (keep dirs, but ignore oversized binaries that can't be pushed)
# -----------------------
# sysmon-bin/
# winlogbeat-bin/
winlogbeat-bin/winlogbeat.exe

# -----------------------
# Local installer binaries (keep local, don't commit)
# -----------------------
TinySocs-Setup.exe
packaging/iss/TinySocs-Setup.exe

# -----------------------
# Local packaging scratch (keep spec tracked)
# -----------------------
# packaging/*.spec  # intentionally NOT ignored

# -----------------------
# Third-party/vendor content (ignore all Sigma/YAML rulepacks etc.)
# -----------------------
rules/sigma/
detections/sigma/
sigma/
vendor/
third_party/
src/tinysocs/agent/detections/sigma/
src/tinysocs/agent/detections/rules/*

# Ignore OpenSearch/Beats/vendor bundles if extracted accidentally
OpenSearch/
OpenSearch/*
# But keep packaging/opensearch/** (dashboards, templates, policies)
!packaging/opensearch/
!packaging/opensearch/**
winlogbeat-*/
beats-*/
opensearch-*/

# -----------------------
# Repo-local runtime artefacts (should not be versioned)
# -----------------------
# Local runtime config (rendered files, not templates)
config/*
!config/agent-config.yml
!config/agent-config.example.yml
!config/version-manifest.json
!config/assistant-knowledge.md
!config/assistant.env
!config/.gitkeep

# Dev/test ledger artefacts created when running from repo
ledger/*.jsonl
ledger/head.json

# Ignore queue paths created during agent runs (any platform)
**/agent/queue/
**/Collector/agent/queue/**

# Ignore local queue segment files created during agent runs
segment-*.jsonl
**/segment-*.jsonl

# Build/deploy staging artefacts (contain large binaries)
deploy-staging/
publish/

# -----------------------
# Certificates / keys (never commit)
# -----------------------
*.pfx
*.p12
*.key
*.pem
!OpenSearch/**/*.pem

# -----------------------
# Runtime log data (keep .gitkeep only)
# -----------------------
logs/*.json
logs/*.txt
logs/*.raw.txt

# -----------------------
# Additional editor / merge artefacts
# -----------------------
*.swp
*.swo
*.orig

# Continuous validation dashboard data (built in CI by
# scripts/build_validation_summary.py from results/*.json; never committed)
# -----------------------
site/validation/data/summary.json
