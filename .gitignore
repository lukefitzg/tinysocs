# Python
__pycache__/
*.py[cod]
*.pyd
.venv/
.env
.env.*.local
!.env.example

# Logs & scratch
*.log
/logs/
/data/*.jsonl
/actions_queue.jsonl
/tinysocs/actions_queue.jsonl

# —— TinySocs build artifacts ——
/build/
/dist/
/artifacts/build/
/artifacts/dist/
/artifacts/support/
/*.spec

# PyInstaller & other bundles
/dist/**/*
/artifacts/dist/**/*

# Test/Tool caches
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/coverage.xml
/.coverage

# Editors
.vscode/

# OS cruft
.DS_Store
Thumbs.db

# Large/vendor (local-only)
winlogbeat-bin/
sysmon-bin/
*.zip

# Keep all integration code tracked
!integrations/
!integrations/**

# Support bundles (generated zips)
artifacts/support/*.zip
