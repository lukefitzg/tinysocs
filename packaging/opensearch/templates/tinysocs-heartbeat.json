{
  "index_patterns": ["tinysocs-heartbeat"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "auto_expand_replicas": "0-1"
    },
    "mappings": {
      "properties": {
        "timestamp": {
          "type": "date"
        },
        "agent": {
          "properties": {
            "version": { "type": "keyword" },
            "hostname": { "type": "keyword" },
            "node_id": { "type": "keyword" },
            "uptime_seconds": { "type": "long" }
          }
        },
        "queue": {
          "properties": {
            "file_count": { "type": "long" },
            "total_bytes": { "type": "long" },
            "last_ship_time": { "type": "date" },
            "total_events_shipped": { "type": "long" }
          }
        }
      }
    }
  }
}
