# Winlogbeat → OpenSearch (TinySocs-managed)
# Keep this file under version control. The deploy script copies it to Program Files:
#   C:\Program Files\TinySocs\Collector\winlogbeat\winlogbeat.yml

winlogbeat.event_logs:
  # Security log (basic audit events)
  - name: Security
    ignore_older: 72h

  # System log (service / driver noise, useful for context)
  - name: System
    ignore_older: 72h

  # Application log (app/service level events)
  - name: Application
    ignore_older: 72h

  # Sysmon telemetry (process, network, registry, etc.) – optional if Sysmon is installed
  - name: Microsoft-Windows-Sysmon/Operational
    ignore_older: 72h
    processors:
      - add_fields:
          target: ''
          fields:
            event.module: sysmon
            tags: [sysmon]

  # PowerShell Script Block Logging (Event ID 4104)
  - name: Microsoft-Windows-PowerShell/Operational
    ignore_older: 72h
    include_event_ids: [4104]
    api: wineventlog                   # ensure structured EventData
    include_event_data: ["ScriptBlockText"]
    # include_xml: true                # optional, to capture raw XML payloads
    processors:
      - add_fields:
          target: ''
          fields:
            event.module: powershell
            tags: [powershell, scriptblock]

# Output: TinyBox OpenSearch on localhost
output.elasticsearch:
  hosts: ["http://127.0.0.1:9200"]
  index: "tinysocs-winlog-%{+yyyy.MM.dd}"
  allow_older_versions: true          # tolerate newer OpenSearch clusters
  worker: 1
  bulk_max_size: 512
  headers:
    Connection: "close"

# TinySOCS owns ILM/templates; keep Beats from fighting us
setup.ilm.enabled: false
setup.template.enabled: false

# Logging to the TinySocs collector log path
logging.level: info
logging.to_files: true
logging.files:
  path: "C:/ProgramData/TinySocs/Collector/logs"
  name: "winlogbeat"
  keepfiles: 7
  rotateeverybytes: 10485760