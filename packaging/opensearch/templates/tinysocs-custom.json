{
  "index_patterns": ["tinysocs-custom-*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "auto_expand_replicas": "0-1",
      "plugins.index_state_management.policy_id": "tinysocs-custom-retention"
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "timestamp": {
          "type": "date"
        },
        "source": {
          "type": "keyword"
        },
        "sourcetype": {
          "type": "keyword"
        },
        "message": {
          "type": "text"
        },
        "event": {
          "type": "object",
          "dynamic": true
        },
        "tinysocs": {
          "properties": {
            "input_name": { "type": "keyword" },
            "node_id": { "type": "keyword" },
            "hec_ingested": { "type": "boolean" }
          }
        }
      }
    }
  }
}
