{
  "index_patterns": ["tinysocs-winlog-*"],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "auto_expand_replicas": "0-1",
      "refresh_interval": "5s",
      "plugins.index_state_management.policy_id": "tinysocs-winlog-retention"
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": { "type": "date" },
        "ts": { "type": "date" },
        "message": { "type": "text" },
        "input": { "type": "keyword" },
        "channel": { "type": "keyword" },
        "eventId": { "type": "long" },
        "openSearchIndex": { "type": "keyword" },
        "body": {
          "type": "object",
          "dynamic": true,
          "properties": {
            "@timestamp": { "type": "date" }
          }
        },
        "event": {
          "properties": {
            "id": { "type": "long" },
            "code": { "type": "long" },
            "level": { "type": "keyword" },
            "provider": { "type": "keyword" },
            "record_id": { "type": "long" }
          }
        },
        "winlog": {
          "properties": {
            "channel": { "type": "keyword" },
            "computer_name": { "type": "keyword" },
            "event_id": { "type": "keyword" },
            "provider_name": { "type": "keyword" },
            "record_id": { "type": "long" }
          }
        },
        "tinysocs": {
          "properties": {
            "input_name": { "type": "keyword" },
            "node_id": { "type": "keyword" }
          }
        }
      }
    }
  }
}