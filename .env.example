# .env.example
# TinySocs .env.example — Golden (OpenSearch-only, Phase 4/5)

# === SIEM target (OpenSearch) ===
SIEM_BACKEND=opensearch
SIEM_URL=https://localhost:9201
SIEM_USER=admin
SIEM_PASS=ChangeMe123!
SIEM_SSL_VERIFY=false
SIEM_TIMEOUT_SECONDS=30

# === LLM selection ===
LLM_MODE=openai            # openai | ollama
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Optional offline LLM (if running Ollama locally)
# LLM_MODE=ollama
# OFFLINE_LLM_URL=http://localhost:11434
# OFFLINE_LLM_MODEL=qwen2.5:0.5b-instruct

# === Paths (agent) ===
ACTIONS_QUEUE_PATH=./data/actions_queue.jsonl
TINYSOCS_RULES=tinysocs/agent/detections/rules.yaml

# === Phase 4/5: Federation + Ledger + Anchors ===
TINYSOCS_NODES=http://localhost:8081

# HMAC/shared secrets
MASTER_SHARED_SECRET=dev-secret-change-me
NODE_SECRET=dev-secret-change-me
BOT_SHARED_SECRET=supersecret

# HMAC style + optional signature prefix
# Styles: pipe (ts|nonce) | dot (ts.nonce) | ts (timestamp only)
TINYSOCS_HMAC_STYLE=pipe
# Leave blank for raw hex; set to 'sha256=' to prefix signatures
TINYSOCS_SIG_PREFIX=

# Node/API TLS behavior (skip verify for local/self-signed)
TINYSOCS_INSECURE_SKIP_VERIFY=1

# Request/timeout budgeting — robust defaults
REQUEST_TIMEOUT_SEC=30
MASTER_DEADLINE_SEC=120
MASTER_RETRIES=3
MASTER_RETRY_MIN_MS=250
MASTER_RETRY_MAX_MS=750
FANOUT_WAIT_ALL=0
HIDE_ZERO_RULES=1

# Anchors
ENSURE_ANCHORS=1
# ALWAYS_ANCHOR=1
# ANCHOR_HEARTBEAT_SEC=300

# Ledger (node-local)
TINYSOCS_LEDGER_DIR=ledger
TINYSOCS_LEDGER_RETENTION_DAYS=30
TINYSOCS_SKEW_SECS=300

# Node serve defaults
# Set 1 on Windows; 2+ fine on Linux
TINYSOCS_NODE_WORKERS=1